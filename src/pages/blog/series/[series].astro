---
import type { GetStaticPaths } from 'astro'
import { getCollection } from 'astro:content'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getSeriesPosts, slugifySeries } from '../../../lib/series'

export const prerender = true

export const getStaticPaths = (async () => {
  const posts = await getCollection('blogPosts')
  const seriesNames = new Set(
    posts
      .filter((post) => import.meta.env.DEV || post.data.isPublished)
      .map((post) => post.data.series)
      .filter((series): series is string => Boolean(series))
  )

  return [...seriesNames].map((series) => ({
    params: { series: slugifySeries(series) },
  }))
}) satisfies GetStaticPaths

const requestedSeries = Astro.params.series
const allPosts = await getCollection('blogPosts')
const availablePosts = allPosts.filter(
  (post) => import.meta.env.DEV || post.data.isPublished
)
const series = [...new Set(availablePosts.map((post) => post.data.series))]
  .filter((name): name is string => Boolean(name))
  .find((name) => slugifySeries(name) === requestedSeries)

if (!series) {
  throw new Error(`Blog series not found: ${requestedSeries}`)
}

const posts = getSeriesPosts(series, availablePosts)
---

<BaseLayout title={`${series} | Blog Series`}>
  <main class="mx-auto max-w-screen-xl p-8">
    <div class="mb-8 border-b border-slate-200 pb-6 dark:border-slate-700">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-300">
        Blog series · {posts.length} {posts.length === 1 ? 'article' : 'articles'}
      </p>
      <h1 class="mb-3 text-4xl font-bold text-slate-950 dark:text-white">{series}</h1>
      <p class="text-lg text-slate-700 dark:text-slate-300">
        Read these articles in order, or pick up where you left off.
      </p>
    </div>

    <ol class="space-y-4" aria-label={`${series} articles in reading order`}>
      {posts.map((post, index) => (
        <li class="dark:border-slate-700 dark:bg-slate-800/30 grid gap-3 rounded-lg border border-slate-200 bg-white p-5 sm:grid-cols-[5rem_1fr] sm:items-center">
          <p class="text-sm font-semibold tabular-nums text-sky-800 dark:text-sky-300">
            {index + 1} <span aria-hidden="true">/</span> {posts.length}
            <span class="sr-only"> of {posts.length}</span>
          </p>
          <div>
            <h2 class="text-xl font-semibold text-slate-950 dark:text-white">
              <a
                href={`/blog/${post.data.slug}`}
                class="rounded underline decoration-sky-500/50 decoration-2 underline-offset-4 hover:decoration-sky-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-600"
              >
                {post.data.title}
              </a>
            </h2>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
              Part {index + 1} of {posts.length}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </main>
</BaseLayout>
